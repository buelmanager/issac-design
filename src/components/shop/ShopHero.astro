---
/**
 * Shop Hero Section — Single-focus Hero
 * 단일 가치 제안 + 듀얼 CTA + 신뢰 배지 + 카테고리 퀵 네비
 * 캐러셀 제거, 메시지 100% 항상 노출
 */
import ShopHeroBackground from './ShopHeroBackground.astro';
import productsData from '../../data/products.json';

// 카테고리별 대표 상품 (isFeatured) 추출
const categoryOrder = ['led-channel', 'neon', 'acrylic', 'banner', 'protruding', 'rooftop'];
const featuredProducts = categoryOrder.map((catId) => {
  const product = productsData.products.find(
    (p) => p.category === catId && p.isFeatured
  );
  return product!;
});
---

<section class="shop-hero" data-shop-hero>
  <!-- LAYER 1: Background -->
  <ShopHeroBackground />

  <!-- LAYER 2: Content -->
  <div class="shop-hero__container">
    <div class="shop-hero__content" data-shop-hero-content>
      <!-- Eyebrow -->
      <span class="shop-hero__eyebrow" data-shop-hero-eyebrow>프리미엄 간판 전문 · 15년 1,000건+</span>

      <!-- Headline -->
      <h2 class="shop-hero__headline">
        <span class="shop-hero__headline-line">
          <span class="shop-hero__headline-text" data-split-text>내 가게에 딱 맞는</span>
        </span>
        <span class="shop-hero__headline-line">
          <span class="shop-hero__headline-text shop-hero__headline-text--accent" data-split-text>간판을 찾아보세요</span>
        </span>
      </h2>

      <!-- Description -->
      <p class="shop-hero__desc" data-shop-hero-desc>
        LED 채널간판, 네온사인, 현수막, 돌출간판 등 16종 이상의 제품을<br class="hide-mobile" />
        온라인에서 비교하고 바로 견적받으세요
      </p>

      <!-- Dual CTA -->
      <div class="shop-hero__cta" data-shop-hero-cta>
        <a href="#products" class="shop-hero__cta-btn shop-hero__cta-btn--primary" data-magnetic>
          <span>제품 둘러보기</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#quote" class="shop-hero__cta-btn shop-hero__cta-btn--secondary" data-magnetic>
          <span>무료 견적 문의</span>
        </a>
        <button class="shop-hero__cta-btn shop-hero__cta-btn--chat" data-open-chat type="button" data-magnetic>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
            <path d="M8 10h.01M12 10h.01M16 10h.01"/>
          </svg>
          <span>AI 상담</span>
        </button>
      </div>

      <!-- Category Products Showcase — Marquee -->
      <div class="shop-hero__showcase" data-shop-hero-categories aria-label="대표 제품">
        <div class="shop-hero__showcase-track">
          {/* 3배 복제로 넓은 화면에서도 끊김 없는 무한 스크롤 */}
          {[...featuredProducts, ...featuredProducts, ...featuredProducts].map((product) => (
            <a href="#products" class="shop-hero__product-card" data-filter={product.category}>
              <div class="shop-hero__product-img-wrap">
                <img
                  src={`${product.thumbnail}&w=240&q=75`}
                  alt={product.name}
                  class="shop-hero__product-img"
                  loading="lazy"
                  decoding="async"
                  width="240"
                  height="180"
                />
              </div>
              <div class="shop-hero__product-info">
                <span class="shop-hero__product-category">{product.categoryName}</span>
                <span class="shop-hero__product-name">{product.name}</span>
                </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- LAYER 3: Scroll Indicator -->
  <button class="shop-hero__scroll" data-shop-hero-scroll aria-label="다음 섹션으로 스크롤" type="button">
    <div class="shop-hero__scroll-line">
      <div class="shop-hero__scroll-dot"></div>
    </div>
  </button>
</section>

<style>
  /* ==================
     Shop Hero — Single-focus
     ================== */
  .shop-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--background);
  }

  /* Container */
  .shop-hero__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .shop-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Eyebrow */
  .shop-hero__eyebrow {
    display: block;
    font-family: var(--font-primary);
    font-size: var(--font-size-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.15em;
    color: rgba(76, 175, 80, 0.7);
    margin-bottom: var(--space-lg);
    opacity: 0;
  }

  /* Headline */
  .shop-hero__headline {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    margin-bottom: var(--space-xl);
  }

  .shop-hero__headline-line {
    display: block;
    overflow: hidden;
    line-height: 1;
  }

  .shop-hero__headline-text {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .shop-hero__headline-text--accent {
    color: var(--primary-light, #4caf50);
  }

  /* Split-text character spans */
  .shop-hero__headline-text :global(.char) {
    display: inline-block;
    opacity: 0;
  }

  .shop-hero__headline-text :global(.char-space) {
    width: 0.3em;
  }

  /* Description */
  .shop-hero__desc {
    font-family: var(--font-primary);
    font-size: var(--font-size-lg);
    font-weight: 300;
    line-height: var(--line-height-relaxed);
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
    opacity: 0;
  }

  .hide-mobile {
    display: inline;
  }

  /* CTA */
  .shop-hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    opacity: 0;
  }

  .shop-hero__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-2xl);
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
    text-decoration: none;
    cursor: pointer;
  }

  .shop-hero__cta-btn--primary {
    color: #fff;
    background: var(--primary-light, #4caf50);
    border: 1px solid var(--primary-light, #4caf50);
  }

  .shop-hero__cta-btn--primary:hover {
    background: #43a047;
    border-color: #43a047;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(76, 175, 80, 0.3);
  }

  .shop-hero__cta-btn--secondary {
    color: var(--text-primary);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .shop-hero__cta-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .shop-hero__cta-btn--chat {
    color: var(--primary-light, #4caf50);
    background: transparent;
    border: 1px solid rgba(76, 175, 80, 0.35);
  }

  .shop-hero__cta-btn--chat:hover {
    background: rgba(76, 175, 80, 0.1);
    border-color: rgba(76, 175, 80, 0.6);
  }

  .shop-hero__cta-btn--chat svg {
    color: var(--primary-light, #4caf50);
  }

  .shop-hero__cta-btn svg {
    transition: transform var(--transition-base);
  }

  .shop-hero__cta-btn:hover svg {
    transform: translateX(4px);
  }

  /* Category Products Showcase — Marquee */
  .shop-hero__showcase {
    --card-w: 180px;
    --card-gap: 16px;
    width: 100%;
    margin-top: var(--space-xl);
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    opacity: 0;
  }

  .shop-hero__showcase-track {
    display: flex;
    gap: var(--card-gap);
    /* 6장 원본 너비만큼 이동 → 복제본으로 이음새 없이 반복 */
    animation: showcaseMarquee 36s linear infinite;
  }

  .shop-hero__showcase:hover .shop-hero__showcase-track {
    animation-play-state: paused;
  }

  @keyframes showcaseMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc((var(--card-w) + var(--card-gap)) * -6)); }
  }

  .shop-hero__product-card {
    flex: 0 0 var(--card-w);
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: background 0.3s, border-color 0.3s;
    cursor: pointer;
  }

  .shop-hero__product-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(76, 175, 80, 0.3);
  }

  .shop-hero__product-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .shop-hero__product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .shop-hero__product-card:hover .shop-hero__product-img {
    transform: scale(1.08);
  }

  .shop-hero__product-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm);
  }

  .shop-hero__product-category {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--primary-light, #4caf50);
  }

  .shop-hero__product-name {
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Scroll Indicator */
  .shop-hero__scroll {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
    cursor: pointer;
    transition: opacity var(--transition-base);
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    outline: none;
  }

  .shop-hero__scroll:focus-visible {
    outline: 2px solid var(--primary-light, #4caf50);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .shop-hero__scroll:hover {
    opacity: 0.8 !important;
  }

  .shop-hero__scroll-line {
    width: 1px;
    height: 48px;
    background: rgba(255, 255, 255, 0.15);
    position: relative;
    overflow: hidden;
  }

  .shop-hero__scroll-dot {
    width: 3px;
    height: 10px;
    background: var(--primary-light, #4caf50);
    border-radius: 2px;
    position: absolute;
    left: -1px;
    animation: shop-hero-scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes shop-hero-scroll-pulse {
    0% { top: 0; opacity: 0.8; }
    50% { top: calc(100% - 10px); opacity: 0.3; }
    100% { top: 0; opacity: 0.8; }
  }

  /* ==================
     Responsive — Tablet
     ================== */
  @media (max-width: 1023px) {
    .shop-hero__headline-text {
      font-size: clamp(3.5rem, 8vw, 6rem);
    }
  }

  /* ==================
     Responsive — Mobile
     ================== */
  @media (max-width: 719px) {
    .shop-hero {
      min-height: 100vh;
      min-height: 100dvh;
    }

    .shop-hero__headline-text {
      font-size: clamp(2.5rem, 10vw, 4rem);
    }

    .shop-hero__desc {
      font-size: var(--font-size-base);
      max-width: 100%;
      padding: 0 var(--space-md);
    }

    .hide-mobile {
      display: none;
    }

    .shop-hero__cta {
      flex-direction: column;
      width: 100%;
      padding: 0 var(--space-md);
    }

    .shop-hero__cta-btn {
      width: 100%;
      justify-content: center;
    }

    .shop-hero__showcase {
      --card-w: 140px;
      --card-gap: 12px;
      margin-top: var(--space-lg);
    }

    .shop-hero__showcase-track {
      animation-duration: 28s;
    }

    .shop-hero__product-info {
      padding: var(--space-xs);
    }

    .shop-hero__product-name {
      font-size: 0.7rem;
    }

    .shop-hero__scroll {
      display: none;
    }
  }

  /* ==================
     Reduced Motion
     ================== */
  @media (prefers-reduced-motion: reduce) {
    .shop-hero__eyebrow,
    .shop-hero__desc,
    .shop-hero__cta,
    .shop-hero__showcase,
    .shop-hero__scroll {
      opacity: 1 !important;
      transform: none !important;
    }

    .shop-hero__headline-text,
    .shop-hero__headline-text :global(.char) {
      opacity: 1 !important;
      transform: none !important;
    }

    .shop-hero__scroll-dot {
      animation: none;
    }

    .shop-hero__showcase-track {
      animation: none;
    }
  }
</style>

<script>
  import { initShopHero, cleanupShopHero } from './shop-hero-animations';

  document.addEventListener('DOMContentLoaded', initShopHero);
  document.addEventListener('astro:page-load', initShopHero);
  document.addEventListener('astro:before-preparation', cleanupShopHero);

  // AI 상담 button → open chatbot
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-open-chat]');
    if (btn) window.dispatchEvent(new CustomEvent('open-chatbot'));
  });
</script>
