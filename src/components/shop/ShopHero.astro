---
/**
 * Shop Hero Section Component
 * Premium full-screen hero with video background, GSAP animations,
 * particles, geometric shapes, mouse tracking, split-text reveal,
 * glitch effect, glassmorphic stats, and scroll indicator
 * Brand-consistent with Landing Hero patterns
 */
import productsData from '../../data/products.json';
const { products } = productsData;
---

<section class="shop-hero" data-shop-hero>
  <!-- Background Layer -->
  <div class="shop-hero-bg">
    <!-- Video Background (Auto-rotating) -->
    <div class="shop-hero-video-wrapper" data-shop-hero-bg-wrapper>
      <!-- Mobile fallback image -->
      <img
        class="shop-hero-video-fallback"
        src="/videos/hero-poster.jpg"
        alt=""
        loading="eager"
        decoding="async"
        data-shop-hero-fallback
      />
      <!-- Per-rotation videos -->
      <video
        class="shop-hero-video is-active"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/videos/hero-poster.jpg"
        data-shop-hero-video="0"
      >
        <source src="/videos/hero-bg-tokyo.mp4" type="video/mp4" />
      </video>
      <video
        class="shop-hero-video"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/videos/hero-poster-1.jpg"
        data-shop-hero-video="1"
      >
        <source src="/videos/hero-slide1-led.mp4" type="video/mp4" />
      </video>
      <video
        class="shop-hero-video"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/videos/hero-poster-2.jpg"
        data-shop-hero-video="2"
      >
        <source src="/videos/hero-slide2-neon.mp4" type="video/mp4" />
      </video>
      <video
        class="shop-hero-video"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/videos/hero-poster-3.jpg"
        data-shop-hero-video="3"
      >
        <source src="/videos/hero-slide3-city.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="shop-hero-bg-overlay"></div>
    <div class="shop-hero-radial"></div>
    <div class="shop-hero-grid"></div>

    <!-- Noise Texture -->
    <div class="shop-hero-noise"></div>

    <!-- Floating Geometric Elements -->
    <div class="shop-hero-geometrics" data-shop-hero-geometrics>
      <div class="shop-geo-shape shop-geo-shape--1" data-shop-geo="1">
        <svg viewBox="0 0 100 100" fill="none">
          <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-width="0.5"/>
          <circle cx="50" cy="50" r="35" stroke="currentColor" stroke-width="0.3"/>
        </svg>
      </div>
      <div class="shop-geo-shape shop-geo-shape--2" data-shop-geo="2">
        <svg viewBox="0 0 100 100" fill="none">
          <rect x="10" y="10" width="80" height="80" stroke="currentColor" stroke-width="0.5" transform="rotate(45 50 50)"/>
        </svg>
      </div>
      <div class="shop-geo-shape shop-geo-shape--3" data-shop-geo="3">
        <svg viewBox="0 0 100 100" fill="none">
          <polygon points="50,5 95,75 5,75" stroke="currentColor" stroke-width="0.5"/>
        </svg>
      </div>
    </div>

    <!-- Particle Dots -->
    <div class="shop-hero-particles" data-shop-hero-particles>
      {Array.from({ length: 12 }).map((_, i) => (
        <div class="shop-particle" data-shop-particle={i} />
      ))}
    </div>

    <!-- Mouse Follower Light -->
    <div class="shop-hero-mouse-light" data-shop-hero-mouse-light></div>
  </div>

  <!-- Content -->
  <div class="shop-hero-container">
    <div class="shop-hero-content" data-shop-hero-content>
      <!-- Label Badge -->
      <span class="shop-hero-badge" data-shop-hero-badge>
        <span class="shop-hero-badge-line"></span>
        <span class="shop-hero-badge-text">issac.design Shop</span>
      </span>

      <!-- Main Title (split-text) -->
      <h1 class="shop-hero-title" data-hero-title>
        <span class="shop-hero-title-line">
          <span class="shop-hero-title-text" data-split-text>빛으로 완성하는</span>
        </span>
        <span class="shop-hero-title-line">
          <span class="shop-hero-title-text shop-hero-title-accent" data-split-text data-accent>Brand Signage</span>
        </span>
      </h1>

      <!-- Subtitle (word-by-word) -->
      <p class="shop-hero-subtitle" data-shop-hero-subtitle>
        <span class="shop-hero-word">LED Signage</span>
        <span class="shop-hero-word">&middot;</span>
        <span class="shop-hero-word">Neon Sign</span>
        <span class="shop-hero-word">&middot;</span>
        <span class="shop-hero-word">Advertising Design</span>
      </p>

      <!-- CTA Button (Single) -->
      <div class="shop-hero-cta" data-shop-hero-cta>
        <a href="#products" class="button button--primary shop-hero-btn" data-magnetic>
          <span class="btn-text">제품 둘러보기</span>
          <span class="btn-shine"></span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Stats Badge (Absolute Right) -->
    <div class="shop-hero-stats" data-hero-stats>
      <div class="shop-hero-stat">
        <span class="shop-hero-stat-number" data-counter-target={products.length}>{products.length}</span>
        <span class="shop-hero-stat-label">Products</span>
      </div>
      <div class="shop-hero-stat-divider"></div>
      <div class="shop-hero-stat">
        <span class="shop-hero-stat-number" data-counter-target="15">15</span>
        <span class="shop-hero-stat-label">Years</span>
      </div>
      <div class="shop-hero-stat-divider"></div>
      <div class="shop-hero-stat">
        <span class="shop-hero-stat-number" data-counter-target="1000" data-counter-suffix="+">1,000+</span>
        <span class="shop-hero-stat-label">Projects</span>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="shop-hero-scroll" data-shop-hero-scroll role="button" aria-label="다음 섹션으로 스크롤" tabindex="0">
    <span class="shop-hero-scroll-text">Scroll</span>
    <div class="shop-hero-scroll-line">
      <div class="shop-hero-scroll-dot"></div>
    </div>
  </div>
</section>

<style>
  /* ==================
     Shop Hero Section
     ================== */
  .shop-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-4xl);
    overflow: hidden;
    background: var(--background);
  }

  /* ==================
     Background Layers
     ================== */
  .shop-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* Video Background */
  .shop-hero-video-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    will-change: transform, opacity;
  }

  .shop-hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    object-fit: cover;
    pointer-events: none;
    filter: brightness(0.7) saturate(1.2);
    opacity: 0;
    transition: opacity 1s ease;
  }

  .shop-hero-video.is-active {
    opacity: 1;
  }

  .shop-hero-video-fallback {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7) saturate(1.2);
  }

  .shop-hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0.6) 70%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }

  .shop-hero-radial {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 50% 40%,
      rgba(26, 77, 46, 0.2) 0%,
      transparent 70%
    );
  }

  .shop-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(76, 175, 80, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(76, 175, 80, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black 0%, transparent 100%);
  }

  /* Noise Texture */
  .shop-hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.5'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
  }

  /* ==================
     Geometric Shapes
     ================== */
  .shop-hero-geometrics {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .shop-geo-shape {
    position: absolute;
    color: rgba(76, 175, 80, 0.12);
    opacity: 0;
    will-change: transform;
  }

  .shop-geo-shape--1 {
    top: 10%;
    left: 5%;
    width: 120px;
    height: 120px;
    animation: shop-geo-rotate 25s linear infinite;
  }

  .shop-geo-shape--2 {
    top: 60%;
    right: 8%;
    width: 90px;
    height: 90px;
    animation: shop-geo-rotate 30s linear infinite reverse;
  }

  .shop-geo-shape--3 {
    bottom: 15%;
    left: 12%;
    width: 80px;
    height: 80px;
    animation: shop-geo-rotate 20s linear infinite;
  }

  @keyframes shop-geo-rotate {
    to { transform: rotate(360deg); }
  }

  /* ==================
     Particles
     ================== */
  .shop-hero-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .shop-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--primary-light, #4caf50);
    border-radius: 50%;
    opacity: 0;
  }

  .shop-particle:nth-child(1) { top: 8%; left: 15%; }
  .shop-particle:nth-child(2) { top: 20%; left: 75%; }
  .shop-particle:nth-child(3) { top: 35%; left: 90%; }
  .shop-particle:nth-child(4) { top: 50%; left: 5%; }
  .shop-particle:nth-child(5) { top: 65%; left: 60%; }
  .shop-particle:nth-child(6) { top: 78%; left: 25%; }
  .shop-particle:nth-child(7) { top: 12%; left: 45%; }
  .shop-particle:nth-child(8) { top: 42%; left: 82%; }
  .shop-particle:nth-child(9) { top: 88%; left: 70%; }
  .shop-particle:nth-child(10) { top: 55%; left: 35%; }
  .shop-particle:nth-child(11) { top: 25%; left: 55%; }
  .shop-particle:nth-child(12) { top: 72%; left: 88%; }

  .shop-particle:nth-child(even) { width: 2px; height: 2px; }

  /* ==================
     Mouse Light
     ================== */
  .shop-hero-mouse-light {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(76, 175, 80, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    will-change: left, top;
    z-index: 1;
  }

  /* ==================
     Container
     ================== */
  .shop-hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* ==================
     Content
     ================== */
  .shop-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-lg);
  }

  /* Badge with Line Deco */
  .shop-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-lg);
    font-size: var(--font-size-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-light);
    background: rgba(26, 77, 46, 0.25);
    border: 1px solid rgba(76, 175, 80, 0.2);
    border-radius: var(--radius-full);
    opacity: 0;
  }

  .shop-hero-badge-line {
    width: 24px;
    height: 1px;
    background: var(--primary-light, #4caf50);
    flex-shrink: 0;
  }

  .shop-hero-badge-text {
    white-space: nowrap;
  }

  /* Title — Split-Text Structure (Oversized) */
  .shop-hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .shop-hero-title-line {
    display: block;
    overflow: hidden;
  }

  .shop-hero-title-text {
    display: inline-block;
    font-size: clamp(3rem, 9vw, var(--font-size-6xl));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .shop-hero-title-accent {
    position: relative;
    background: linear-gradient(135deg, var(--primary-light, #4caf50) 0%, var(--accent, #66bb6a) 50%, var(--primary-light, #4caf50) 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shop-gradient-shift 4s ease infinite;
  }

  @keyframes shop-gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Glitch Effect on Accent */
  .shop-hero-title-accent[data-glitch]::before,
  .shop-hero-title-accent[data-glitch]::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--primary-light, #4caf50) 0%, var(--accent, #66bb6a) 50%, var(--primary-light, #4caf50) 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .shop-hero-title-accent[data-glitch]::before {
    left: 2px;
    text-shadow: -2px 0 #ff0080;
    clip-path: inset(0 0 0 0);
    animation: shop-glitch-1 2s infinite linear alternate-reverse;
  }

  .shop-hero-title-accent[data-glitch]::after {
    left: -2px;
    text-shadow: 2px 0 #00ffff;
    clip-path: inset(0 0 0 0);
    animation: shop-glitch-2 2s infinite linear alternate-reverse;
  }

  @keyframes shop-glitch-1 {
    0%, 100% { clip-path: inset(0 0 95% 0); }
    20% { clip-path: inset(20% 0 60% 0); }
    40% { clip-path: inset(40% 0 40% 0); }
    60% { clip-path: inset(60% 0 20% 0); }
    80% { clip-path: inset(80% 0 5% 0); }
  }

  @keyframes shop-glitch-2 {
    0%, 100% { clip-path: inset(95% 0 0 0); }
    20% { clip-path: inset(60% 0 20% 0); }
    40% { clip-path: inset(40% 0 40% 0); }
    60% { clip-path: inset(20% 0 60% 0); }
    80% { clip-path: inset(5% 0 80% 0); }
  }

  /* Split-text character spans (injected by GSAP) */
  .shop-hero-title-text :global(.char) {
    display: inline-block;
    opacity: 0;
    will-change: transform, opacity;
  }

  /* Subtitle — Word-by-Word */
  .shop-hero-subtitle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-xs);
    font-size: var(--font-size-lg);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .shop-hero-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(10px);
  }

  /* CTA Button */
  .shop-hero-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-lg);
    opacity: 0;
  }

  .shop-hero-btn {
    position: relative;
    overflow: hidden;
  }

  .shop-hero-btn svg {
    transition: transform var(--transition-base);
  }

  .shop-hero-btn:hover svg {
    transform: translateX(4px);
  }

  /* Button Shine Effect */
  .btn-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.15) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  .shop-hero-btn:hover .btn-shine {
    animation: shop-btn-shine 0.6s ease forwards;
  }

  @keyframes shop-btn-shine {
    to { left: 100%; }
  }

  /* ==================
     Stats Badge — Absolute Right, Glassmorphic
     ================== */
  .shop-hero-stats {
    position: absolute;
    right: var(--container-padding);
    bottom: 120px;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg) var(--space-xl);
    background: rgba(26, 77, 46, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(76, 175, 80, 0.15);
    border-radius: var(--radius-lg);
    opacity: 0;
    transform: translateX(30px);
  }

  .shop-hero-stat {
    text-align: center;
    position: relative;
  }

  .shop-hero-stat-number {
    display: inline-block;
    font-size: var(--font-size-3xl);
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .shop-hero-stat-label {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--font-size-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .shop-hero-stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(76, 175, 80, 0.3) 50%,
      transparent 100%
    );
  }

  /* ==================
     Scroll Indicator
     ================== */
  .shop-hero-scroll {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    z-index: 2;
    opacity: 0;
    cursor: pointer;
    transition: opacity var(--transition-base);
  }

  .shop-hero-scroll:hover {
    opacity: 0.8 !important;
  }

  .shop-hero-scroll-text {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .shop-hero-scroll-line {
    width: 1px;
    height: 40px;
    background: rgba(76, 175, 80, 0.2);
    position: relative;
    overflow: hidden;
    border-radius: 1px;
  }

  .shop-hero-scroll-dot {
    width: 3px;
    height: 8px;
    background: var(--primary-light, #4caf50);
    border-radius: 2px;
    position: absolute;
    left: -1px;
    animation: shop-scroll-bounce 1.8s ease-in-out infinite;
  }

  @keyframes shop-scroll-bounce {
    0% { top: 0; opacity: 1; }
    50% { top: 100%; opacity: 0.3; }
    100% { top: 0; opacity: 1; }
  }

  /* ==================
     Responsive — Tablet
     ================== */
  @media (max-width: 1023px) {
    .shop-hero-title-text {
      font-size: clamp(2.5rem, 7vw, var(--font-size-5xl));
    }

    .shop-hero-geometrics {
      display: none;
    }

    .shop-particle:nth-child(n+7) {
      display: none;
    }

    .shop-hero-mouse-light {
      width: 300px;
      height: 300px;
    }

    .shop-hero-stats {
      right: var(--container-padding);
      bottom: 100px;
    }
  }

  /* ==================
     Responsive — Mobile
     ================== */
  @media (max-width: 719px) {
    .shop-hero {
      padding-top: calc(var(--header-height-mobile) + var(--space-3xl));
      padding-bottom: var(--space-3xl);
      min-height: auto;
    }

    .shop-hero-title-text {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .shop-hero-subtitle {
      font-size: var(--font-size-sm);
    }

    .shop-hero-cta {
      width: 100%;
    }

    .shop-hero-btn {
      width: 100%;
      justify-content: center;
    }

    .shop-hero-video {
      display: none;
    }

    .shop-hero-video-fallback {
      display: block;
    }

    .shop-hero-stats {
      position: relative;
      right: auto;
      bottom: auto;
      transform: none;
      flex-direction: column;
      gap: var(--space-lg);
      padding: var(--space-xl) var(--space-2xl);
      width: 100%;
      margin-top: var(--space-2xl);
    }

    .shop-hero-stat-divider {
      width: 60px;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(76, 175, 80, 0.3) 50%,
        transparent 100%
      );
    }

    .shop-hero-particles,
    .shop-hero-geometrics {
      display: none;
    }

    .shop-hero-mouse-light {
      display: none;
    }

    .shop-hero-scroll {
      display: none;
    }
  }

  /* ==================
     Reduced Motion
     ================== */
  @media (prefers-reduced-motion: reduce) {
    .shop-hero-btn svg,
    .btn-shine {
      transition: none;
      animation: none;
    }

    .shop-geo-shape {
      animation: none;
    }

    .shop-hero-scroll-dot {
      animation: none;
    }

    .shop-hero-title-accent {
      animation: none;
    }

    .shop-hero-title-accent[data-glitch]::before,
    .shop-hero-title-accent[data-glitch]::after {
