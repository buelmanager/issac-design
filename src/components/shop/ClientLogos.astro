---

<section class="client-logos" data-client-logos>
  <div class="client-logos__container">
    <h3 class="client-logos__title">1,000+ 기업이 신뢰하는 Signage Partner</h3>
    <p class="client-logos__subtitle">
      전국 레스토랑, 카페, 리테일, 오피스부터 럭셔리 브랜드까지<br class="mobile-br-hide" />
      다양한 업종의 프리미엄 간판 시공 실적 보유
    </p>
  </div>

  <div class="client-logos__track-wrapper">
    <div class="client-logos__track">
      {/* First set */}
      {logos.map((logo) => (
        <div class="client-logos__item">
          <span class="client-logos__icon" set:html={logo.icon} />
          <span class="client-logos__name">{logo.name}</span>
        </div>
      ))}
      {/* Duplicate set for seamless loop */}
      {logos.map((logo) => (
        <div class="client-logos__item">
          <span class="client-logos__icon" set:html={logo.icon} />
          <span class="client-logos__name">{logo.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ============================================
     ClientLogos - Marquee Scroll
     ============================================ */

  /* Section */
  .client-logos {
    position: relative;
    padding: var(--space-4xl) 0;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, var(--background) 0%, var(--background-elevated) 100%);
    overflow: hidden;
  }

  .client-logos::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(26, 77, 46, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(76, 175, 80, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }

  /* Container */
  .client-logos__container {
    position: relative;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    text-align: center;
    margin-bottom: var(--space-3xl);
    z-index: 1;
  }

  /* Title */
  .client-logos__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--text-primary);
    margin-bottom: var(--space-md);
    background: linear-gradient(135deg, #FFFFFF 0%, rgba(255, 255, 255, 0.8) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Subtitle */
  .client-logos__subtitle {
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin: 0 auto;
  }

  .mobile-br-hide {
    display: inline;
  }

  /* Track Wrapper - overflow hidden + edge fade */
  .client-logos__track-wrapper {
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  /* Marquee Animation */
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Track */
  .client-logos__track {
    display: flex;
    gap: var(--space-3xl);
    width: max-content;
    animation: marquee 30s linear infinite;
    will-change: transform;
  }

  .client-logos__track:hover {
    animation-play-state: paused;
  }

  /* Logo Item */
  .client-logos__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
    padding: var(--space-lg);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    cursor: default;
    opacity: 0.6;
    transition: all 0.3s ease;
  }

  .client-logos__item:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(76, 175, 80, 0.3);
    transform: translateY(-2px);
  }

  /* Icon Container */
  .client-logos__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 50px;
    color: var(--grey-500);
    transition: color 0.3s ease;
  }

  .client-logos__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .client-logos__item:hover .client-logos__icon {
    color: var(--primary-light);
  }

  /* Name */
  .client-logos__name {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: var(--letter-spacing-wide);
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .client-logos__item:hover .client-logos__name {
    color: var(--text-primary);
  }

  /* ============================================
     Responsive
     ============================================ */

  /* Tablet */
  @media (max-width: 1023px) {
    .client-logos__track {
      gap: var(--space-2xl);
    }
  }

  /* Mobile */
  @media (max-width: 719px) {
    .client-logos {
      padding: var(--space-3xl) 0;
    }

    .client-logos__container {
      margin-bottom: var(--space-2xl);
    }

    .client-logos__title {
      font-size: var(--font-size-xl);
    }

    .client-logos__subtitle {
      font-size: var(--font-size-sm);
    }

    .mobile-br-hide {
      display: none;
    }

    .client-logos__item {
      padding: var(--space-md);
    }

    .client-logos__icon {
      width: 60px;
      height: 40px;
    }

    .client-logos__track {
      gap: var(--space-xl);
      animation-duration: 20s;
    }

    .client-logos__name {
      font-size: 0.625rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .client-logos__track {
      animation-play-state: paused;
    }
  }
</style>
