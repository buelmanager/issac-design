---
/**
 * ProductSimulatorSection
 * Astro wrapper for the React-based 3D ProductSimulator
 * Displays on product detail pages
 */

import ProductSimulator from './ProductSimulator';
---

<section class="simulator-section" data-simulator-section>
  <ProductSimulator client:load />
</section>

<style>
  /* ============================================
     Product Simulator Section
     ============================================ */

  .simulator-section {
    position: relative;
    width: 100%;
    padding: var(--space-4xl) 0;
    background: linear-gradient(180deg, var(--background) 0%, var(--background-elevated) 100%);
    border-top: 1px solid var(--border);
  }

  /* Container */
  :global(.product-simulator__container) {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* Header */
  :global(.product-simulator__header) {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  :global(.product-simulator__title) {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-md);
    letter-spacing: var(--letter-spacing-tight);
  }

  :global(.product-simulator__description) {
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Content Grid */
  :global(.product-simulator__content) {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  /* Canvas */
  :global(.product-simulator__canvas) {
    position: relative;
    width: 100%;
    height: 600px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #1a1a2e;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Loading State */
  :global(.product-simulator__loading) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    background: rgba(26, 26, 46, 0.9);
    color: var(--text-primary);
    font-size: var(--font-size-sm);
    z-index: 10;
  }

  :global(.spinner) {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--primary-light);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Error State */
  :global(.product-simulator__error) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: var(--space-lg);
    background: rgba(244, 67, 54, 0.1);
    border: 1px solid rgba(244, 67, 54, 0.3);
    border-radius: var(--radius-md);
    color: #ff6b6b;
    font-size: var(--font-size-sm);
    text-align: center;
    max-width: 300px;
  }

  /* Controls */
  :global(.product-simulator__controls) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  :global(.simulator-control) {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  :global(.simulator-control__label) {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  :global(.simulator-control__hint) {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    margin-top: var(--space-xs);
  }

  /* Upload Button */
  :global(.simulator-upload) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: rgba(255, 255, 255, 0.03);
    border: 2px dashed rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  :global(.simulator-upload:hover) {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--primary-light);
  }

  :global(.simulator-upload svg) {
    width: 32px;
    height: 32px;
    color: var(--primary-light);
  }

  :global(.simulator-upload span) {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Material Presets */
  :global(.simulator-presets) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  :global(.simulator-preset) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-lg) var(--space-md);
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  :global(.simulator-preset:hover) {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(76, 175, 80, 0.3);
  }

  :global(.simulator-preset.active) {
    background: linear-gradient(135deg, rgba(26, 77, 46, 0.2) 0%, rgba(76, 175, 80, 0.1) 100%);
    border-color: var(--primary-light);
  }

  :global(.simulator-preset__icon) {
    font-size: 2rem;
  }

  :global(.simulator-preset__label) {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  :global(.simulator-preset.active .simulator-preset__label) {
    color: var(--primary-light);
  }

  /* Info */
  :global(.simulator-info) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: rgba(76, 175, 80, 0.05);
    border: 1px solid rgba(76, 175, 80, 0.2);
    border-radius: var(--radius-md);
  }

  :global(.simulator-info__item) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
  }

  :global(.simulator-info__item svg) {
    width: 16px;
    height: 16px;
    color: var(--primary-light);
    flex-shrink: 0;
  }

  /* ============================================
     Responsive
     ============================================ */

  /* Tablet */
  @media (max-width: 1023px) {
    :global(.product-simulator__content) {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    :global(.product-simulator__canvas) {
      height: 500px;
    }
  }

  /* Mobile */
  @media (max-width: 719px) {
    .simulator-section {
      padding: var(--space-3xl) 0;
    }

    :global(.product-simulator__header) {
      margin-bottom: var(--space-2xl);
    }

    :global(.product-simulator__title) {
      font-size: var(--font-size-2xl);
    }

    :global(.product-simulator__canvas) {
      height: 400px;
    }

    :global(.simulator-presets) {
      grid-template-columns: 1fr;
    }

    :global(.simulator-preset) {
      flex-direction: row;
      justify-content: center;
      padding: var(--space-md);
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    :global(.spinner) {
      animation: none;
      border-top-color: var(--primary);
    }
  }
</style>
